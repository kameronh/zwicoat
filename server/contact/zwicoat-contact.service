[Unit]
Description=ZwiCoat contact form endpoint (gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zwicoat-contact
EnvironmentFile=/etc/zwicoat-contact.env
# One worker on purpose: the rate limiter keeps its counts in memory.
ExecStart=/home/ubuntu/zwicoat-contact/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5057 --access-logfile - app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
