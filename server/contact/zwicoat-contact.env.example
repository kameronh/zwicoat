# Copy to /etc/zwicoat-contact.env, then: sudo chown root:root and sudo chmod 600.
# systemd reads this file. Do not wrap values in quotes.

SMTP_HOST=smtp.example.com
# 587 uses STARTTLS. 465 uses SSL from the first byte.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where messages go. Defaults to info@zwicoat.com.
MAIL_TO=info@zwicoat.com
# Sender address. Defaults to SMTP_USER. The SMTP provider must allow it.
MAIL_FROM=info@zwicoat.com

# 1 logs the message instead of sending it. Leave 0 in production.
DRY_RUN=0
# 1 allows CORS from http://localhost:4321 (Astro dev server). Leave 0 in production.
DEV_CORS=0
# 1 reads the client IP from the last X-Forwarded-For value (set by Apache). Keep 1 behind Apache.
TRUST_PROXY=1
