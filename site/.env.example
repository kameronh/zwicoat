# Copy to site/.env for local work. Public values only: PUBLIC_ variables are readable in the browser.
# Production: same-origin endpoint served by the Flask app behind Apache.
PUBLIC_FORM_ENDPOINT=/api/contact
# Local dev against the Flask app (run it with DRY_RUN=1 DEV_CORS=1, see server/contact/README.md):
# PUBLIC_FORM_ENDPOINT=http://127.0.0.1:5057/api/contact
