---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import team from '../data/team.json';
---
<Base title="About" description="ZwiCoat Materials Innovations is a University of Iowa spin-off, co-founded by the inventors of the ZwiGuard zwitterionic hydrogel coating.">
  <div class="container section">
    <header class="page-head">
      <p class="label">About</p>
      <h1>A University of Iowa spin-off, started by the inventors.</h1>
    </header>

    <section class="company" aria-labelledby="company-h">
      <h2 id="company-h" class="visually-hidden">The company</h2>
      <div class="prose">
        <p class="lead">ZwiCoat Materials Innovations, LLC (ZCMI) makes ZwiGuard&trade;, a zwitterionic hydrogel coating for medical devices.</p>
        <p>The company is a University of Iowa spin-off. It was co-founded by the inventors of the coating.</p>
        <p>An NIH SBIR Phase I award funded coated prototypes and feasibility work. An NIH SBIR Phase II award funds the cochlear implant program.</p>
        <p>The company is based in Solon, Iowa, and is 100 percent founder owned.</p>
        <p class="collab"><span class="label">Collaborators</span> University of Iowa Departments of Otolaryngology and of Chemical and Biochemical Engineering; Brigham Young University (Guymon lab).</p>
      </div>
    </section>

    <section class="people" aria-labelledby="team-h">
      <h2 id="team-h">Leadership</h2>
      <ul class="team" role="list">
        {team.map((m) => (
          <li class="member">
            <div class="portrait">
              <Photo src={m.photo} alt={m.alt} aspect="1/1" cover />
            </div>
            <div class="bio">
              <h3>{m.name}</h3>
              <p class="label role">{m.title}</p>
              <p class="short">{m.shortBio}</p>
              <details>
                <summary>Read more</summary>
                <p class="full">{m.fullBio}</p>
              </details>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>

</Base>

<style>
  .company { padding-bottom: var(--space-6); }
  .company .prose { max-width: var(--measure); }
  .collab { padding-top: var(--space-3); border-top: 1px solid var(--line); color: var(--ink-2); }
  .collab .label { display: block; margin-bottom: 0.3rem; }
  .people { border-top: 1px solid var(--ink); padding-top: var(--space-5); display: grid; gap: var(--space-5); }
  .team { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; }
  .member { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-top: 1px solid var(--line); }
  .member:first-child { border-top: 0; padding-top: 0; }
  .portrait { max-width: 220px; }
  .bio { display: grid; gap: var(--space-2); align-content: start; max-width: var(--measure); }
  .role { color: var(--blue-deep); }
  .short { margin-top: var(--space-2); }
  details { margin-top: var(--space-2); }
  summary { color: var(--blue); font-weight: 600; text-underline-offset: 0.18em; }
  summary:hover { color: var(--blue-deep); }
  .full { margin-top: var(--space-3); color: var(--ink-2); }
  @media (min-width: 720px) {
    .member { grid-template-columns: 220px minmax(0, 1fr); column-gap: var(--space-5); }
  }
</style>
