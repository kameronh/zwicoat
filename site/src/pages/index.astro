---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatTiles from '../components/StatTiles.astro';
import ClaimRow from '../components/ClaimRow.astro';
import Figure from '../components/Figure.astro';
import ProcessVideo from '../components/ProcessVideo.astro';
import ApplicationCard from '../components/ApplicationCard.astro';
import Steps from '../components/Steps.astro';
import CTABand from '../components/CTABand.astro';
import InteractiveChart from '../components/InteractiveChart.astro';
import { W07, W25, W26, W28, W29 } from '../data/figure-text';
import numbers from '../../public/data/W12_numbers.json';
import apps from '../data/applications-index.json';

const tiles = numbers;

const steps = [
  { n: 1, title: 'Feasibility, free', body: 'You send parts. We coat them, with no cap on quantity, and return them with matched uncoated controls and our data.' },
  { n: 2, title: 'Joint development', body: 'We optimize the coating on your production devices and run ISO 10993, sterilization, aging and an animal model.' },
  { n: 3, title: 'Manufacturing', body: 'We coat for you. Our FDA Device Master File sits behind your submission.' },
];
---
<Base title="ZwiCoat" description="ZwiGuard is a zwitterionic hydrogel coating, covalently bonded to the device, that keeps protein, cells and bacteria off. Ten years of evidence.">
  <Hero />

  <section class="section container" aria-labelledby="numbers-h">
    <h2 id="numbers-h" class="visually-hidden">The public record in numbers</h2>
    <StatTiles items={tiles} columns={4} />
    <p class="tiles-note">Every number on this site comes from a published paper, dissertation or issued patent.</p>
    <p class="tiles-note">And behind the papers: <a href="/evidence#archive">182 archived experiments, 1,056 adhesion tests, 136 animals.</a></p>
    <p class="tiles-note tiles-src label">Sources: the ten journal papers and the dissertations listed on the Publications page, USPTO records, ZCMI patent schedule, 2025.</p>
  </section>

  <section class="section container" aria-label="What the coating does">
    <ClaimRow label="Less scar" title="Less inflammation and less scar tissue at the sheep round window.">
      <p>In three sheep, each with one coated and one uncoated human cochlear implant array, the coated ears had fewer cell nuclei (p = 0.0020), fewer macrophages (p = 0.0063) and less fibrous tissue (p = 0.0101) at four weeks. Each line is one sheep.</p>
      <p>One sheep showed no difference in cells or macrophages, and the authors call the study a small pilot (Ben-Shlomo 2026, Hearing Research). Across mice, rats and sheep, scar was about 45 to 85 percent lower. <a href="/evidence#scar">See every scar measurement.</a></p>
      <Figure slot="figure" name={W26.name} alt={W26.alt} caption={W26.caption} source={W26.source} width={900} />
    </ClaimRow>

    <ClaimRow label="Lower impedance" title="Coated implant arrays read about half the impedance of uncoated ones." reverse>
      <p>Working human cochlear implant arrays in sheep read 67 percent lower total impedance at implantation and 47 percent lower four weeks later. Access resistance was lower too.</p>
      <p>Three sheep, one coated and one uncoated array each (Ben-Shlomo 2026, Hearing Research). No coated device has been implanted in a person.</p>
      <Figure slot="figure" name={W25.name} alt={W25.alt} caption={W25.caption} source={W25.source} width={900} />
    </ClaimRow>

    <ClaimRow label="Easier insertion" title={W07.title}>
      <p>{W07.body}</p>
      <Figure slot="figure" name={W07.name} alt={W07.alt} caption={W07.caption} source={W07.source} width={900} />
    </ClaimRow>

    <ClaimRow label="Fewer bacteria" title="Far fewer bacteria on coated implants in rats." reverse>
      <p>Silicone implants were placed in rats and challenged with S. aureus. At day 21, coated implants carried far fewer adherent bacteria and live colonies than uncoated ones (Shen 2021, ACS Applied Bio Materials).</p>
      <p>A coating kept in a rat for two weeks still resisted a fresh challenge. These are animal results, not clinical results.</p>
      <p><a href="/evidence#antifouling">Browse every protein, cell, bacteria and friction comparison on the evidence page.</a></p>
      <Figure slot="figure" name={W29.name} alt={W29.alt} caption={W29.caption} source={W29.source} width={900} />
    </ClaimRow>

    <ClaimRow label="It stays on" title="Friction was unchanged after three weeks in mice.">
      <p>Coated silicone was implanted in mice for three weeks, then taken out and tested. It kept about 90 percent lower friction than uncoated silicone (Peel 2024).</p>
      <p>The hydrogel is covalently grafted, so it is part of the surface rather than a layer on top of it. At one year in mice the film was still intact (Horne 2023).</p>
      <p><a href="/durability">Full durability record</a></p>
      <Figure slot="figure" name={W28.name} alt={W28.alt} caption={W28.caption} source={W28.source} width={1000} />
    </ClaimRow>
  </section>

  <section class="section container" aria-labelledby="timeline-h">
    <div class="section-head wide">
      <p class="label">The record</p>
      <h2 id="timeline-h">Ten years of published work</h2>
      <p class="tl-lead">Ten papers, three dissertations and three issued US patents, 2017 to 2026. Hover or focus a marker to read what it found.</p>
    </div>
    <InteractiveChart
      id="timeline"
      name="W24_publication_timeline"
      alt="Timeline of the public record, 2017 to 2026, in three rows. Ten peer-reviewed papers run from 2017 to 2026, three University of Iowa dissertations were completed in 2018 and 2023, and three US patents were issued in 2022, 2023 and 2024."
      caption="Timeline of the public record, 2017 to 2026: ten peer-reviewed papers, three PhD dissertations and three issued US patents."
      source="Leigh 2017 Biomacromolecules; Leigh 2019 Langmuir; Jensen 2021 ACS Biomaterials Science and Engineering; Shen 2021 ACS Applied Bio Materials; Bennion 2021 Otology and Neurotology; Horne 2023 Acta Biomaterialia; Peel 2024 ACS Applied Bio Materials; Horne 2025 Laryngoscope Investigative Otolaryngology; Ben-Shlomo 2026 Hearing Research; Barrera 2026 ACS Applied Polymer Materials; dissertations Leigh 2018, Peel 2023, Horne 2023 (University of Iowa); US patents 11,525,069 (2022), 11,814,526 (2023), 12,116,498 (2024)."
    />
  </section>

  <section class="section container proc-grid" aria-label="The coating process">
    <ProcessVideo poster="/images/process-poster.png" caption="Automated dip coating: one step. Video coming." />
    <div class="proc-text">
      <p class="label">The process</p>
      <h2>One dip, one UV step.</h2>
      <p>The part is dipped into the monomer solution, then moved under UV light. One UV step grafts the film and crosslinks it.</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="apps-h">
    <div class="section-head">
      <p class="label">Applications</p>
      <h2 id="apps-h">Nine device families, one number that matters for each.</h2>
    </div>
    <ul class="grid" role="list">
      {apps.map((a) => (
        <li><ApplicationCard slug={a.slug} title={a.title} stat={a.stat} statLabel={a.statLabel} image={a.image} alt={a.alt} /></li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="work-h">
    <div class="section-head">
      <p class="label">How we work together</p>
      <h2 id="work-h">Three steps, and the first one is free.</h2>
    </div>
    <Steps steps={steps} />
  </section>

  <section class="section container" aria-label="Credentials">
    <dl class="cred">
      <div><dt class="label">Origin</dt><dd>University of Iowa spin-off.</dd></div>
      <div><dt class="label">Funding</dt><dd>NIH SBIR Phase I and Phase II.</dd></div>
      <div><dt class="label">Patents</dt><dd>US 11,525,069; 11,814,526; 12,116,498.</dd></div>
      <div><dt class="label">Papers</dt><dd>Ten peer-reviewed papers.</dd></div>
    </dl>
  </section>

  <CTABand
    title="Bring us a device with a fouling, scar or friction problem."
    body="We coat it free, with no cap on quantity, and return it with matched uncoated controls and data."
    button={{ text: 'Send us parts', href: '/partner#form' }}
  />
</Base>

<script>
  import { mount as mountTimeline } from '../scripts/timeline';
  import type { PubRecord } from '../scripts/timeline';
  import { showFallback } from '../scripts/chart-utils';
  // Inlined into the bundle at build time; nothing is fetched.
  import publications from '../../public/data/W24_publications.json';

  const root = document.querySelector<HTMLElement>('[data-chart="timeline"]');
  if (root) {
    try {
      mountTimeline(root, publications as PubRecord[]);
    } catch (err) {
      console.error('Chart "timeline" failed to mount; showing the static image.', err);
      showFallback(root);
    }
  }
</script>

<style>
  .proc-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .proc-text { display: grid; gap: var(--space-3); max-width: 36ch; align-content: center; }
  @media (min-width: 720px) { .proc-grid { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); column-gap: var(--space-6); } }
  .tl-lead { color: var(--ink-2); max-width: var(--measure); }
  .section-head.wide { max-width: none; }
  .tiles-note { margin-top: var(--space-3); color: var(--ink-2); font-size: var(--fs-caption); }
  .tiles-note a { color: var(--blue); text-underline-offset: 0.18em; }
  .tiles-note.tiles-src { margin-top: var(--space-2); text-transform: none; letter-spacing: 0.02em; }
  .section-head { display: grid; gap: var(--space-2); margin-bottom: var(--space-5); max-width: 32ch; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cred {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .cred > div { display: grid; gap: 0.35rem; padding: var(--space-3) 0; border-bottom: 1px solid var(--line); }
  .cred > div:last-child { border-bottom: 0; }
  .cred dd { margin: 0; font-size: var(--fs-lead); font-weight: 500; line-height: 1.35; }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1020px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cred { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cred > div { border-bottom: 0; padding: var(--space-4) var(--space-3); border-left: 1px solid var(--line); }
    .cred > div:first-child { border-left: 0; padding-left: 0; }
  }
</style>
