---
import { imageSize } from '../lib/imagesize';

interface Props {
  slug: string;
  title: string;
  stat: string;
  statLabel: string;
  image: string | null;
  alt: string;
}
const { slug, title, stat, statLabel, image, alt } = Astro.props;
// Tall, square-ish or very wide photos would be cropped badly by cover; show them whole on a tinted panel.
let fit = 'cover';
if (image) {
  const s = imageSize(image);
  const ratio = s.width / s.height;
  if (ratio < 1.2 || ratio > 2.2) fit = 'contain';
}
---
<a class:list={['card', { compact: !image }]} href={`/applications/${slug}`}>
  {image && (
    <div class={`media media-photo fit-${fit}`}>
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="body">
    <h3 class="card-title">{title}</h3>
    <p class="stat">{stat}</p>
    <p class="stat-label label">{statLabel}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .card:hover { border-color: var(--blue); }
  .card:hover .card-title { color: var(--blue-deep); }
  .media { aspect-ratio: 4 / 3; border-bottom: 1px solid var(--line); background: var(--paper-2); overflow: hidden; }
  .media-photo img { width: 100%; height: 100%; }
  .fit-cover img { object-fit: cover; }
  .fit-contain { background: var(--blue-tint); }
  .fit-contain img { object-fit: contain; padding: var(--space-3); }
  .body { display: flex; flex-direction: column; gap: 0.5rem; padding: var(--space-3) var(--space-4) var(--space-4); flex: 1; }
  .card-title { font-size: 1.25rem; line-height: 1.2; min-height: 2.4em; }
  .stat {
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 700;
    letter-spacing: var(--tracking-head);
    line-height: 1;
    color: var(--blue);
  }
  .stat-label { text-transform: none; letter-spacing: 0.01em; line-height: 1.5; }

  /* No photo: the whole card is one compact tinted panel. */
  .compact { background: var(--blue-tint); border-color: transparent; }
  .compact:hover { border-color: var(--blue); }
  .compact .body { padding: var(--space-4); gap: var(--space-3); }
  .compact .card-title { color: var(--blue-deep); font-size: 1.375rem; min-height: 2.4em; }
  .compact .stat { margin-top: auto; }
  .compact .stat-label { color: var(--ink-2); font-size: var(--fs-label); }
</style>
