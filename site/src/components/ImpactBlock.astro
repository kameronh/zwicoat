---
/*
  The pendulum impact test (R13, R18): the looping clip on the left, the before and after
  photographs (deck slide 1) stacked on the right, one cited caption for the set.
  Used on /durability (Mechanical) and, through {{block:impact}}, on the tissue expander page.
*/
import VideoLoop from './VideoLoop.astro';
import Photo from './Photo.astro';

interface Props {
  /** Stack the photos under the clip instead of beside it (for narrow columns). */
  narrow?: boolean;
}
const { narrow = false } = Astro.props;
const credit = 'ZwiCoat, 2026';
---
<figure class:list={['impact', { narrow }]}>
  <div class="impact-grid">
    <div class="impact-video">
      <VideoLoop
        src="/media/pendulum-loop"
        poster="/media/pendulum-poster.jpg"
        aspect="540/810"
        caption="The pendulum strikes the coated expander, close-up."
        alt="Close-up of a weighted pendulum striking a blue-coated tissue expander mounted on a backboard."
        credit={credit}
      />
    </div>
    <div class="impact-photos">
      <Photo
        src="/images/lab/expander-impact-before.jpg"
        alt="The back of a blue-coated tissue expander lying flat on a white surface before the impact test. The coating is even across the shell."
        caption="Before impact"
        credit={credit}
        aspect="2000/1000"
      />
      <Photo
        src="/images/lab/expander-impact-after.jpg"
        alt="The same blue-coated tissue expander after the pendulum impact. The coating looks the same as before, with no cracks, peeling or bare patches."
        caption="After impact: no visible damage"
        credit={credit}
        aspect="2000/1000"
      />
    </div>
  </div>
  <figcaption class="impact-cap">
    <p class="impact-caption">A 45 J pendulum strike on a coated tissue expander.</p>
    <p class="impact-source label">Source: ZwiCoat internal test, 2026</p>
  </figcaption>
</figure>

<style>
  .impact { margin: 0; min-width: 0; max-width: 62rem; }
  .impact-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .impact-video { min-width: 0; max-width: 20rem; }
  .impact-photos { display: grid; gap: var(--space-4); min-width: 0; }
  @media (min-width: 640px) {
    .impact:not(.narrow) .impact-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .impact:not(.narrow) .impact-video { max-width: none; }
  }
  .impact-cap { margin-top: var(--space-3); display: grid; gap: 0.35rem; max-width: var(--measure); }
  .impact-caption { color: var(--ink); }
  .impact-source { text-transform: none; letter-spacing: 0.02em; line-height: 1.5; }
</style>
