---
interface Props {
  count?: number;
}
const html = await Astro.slots.render('default');
const counted = (html.match(/<li[\s>]/g) ?? []).length;
const n = Astro.props.count ?? counted;
---
<details class="refs">
  <summary class="label">References ({n})</summary>
  <ol class="refs-list" set:html={html} />
</details>

<style>
  .refs { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: var(--space-3); max-width: var(--measure); }
  .refs summary { color: var(--ink-2); padding-block: 0.4rem; }
  .refs summary:hover { color: var(--blue); }
  .refs-list { margin: var(--space-3) 0 0; padding-left: 1.6em; font-size: var(--fs-caption); color: var(--ink-2); display: grid; gap: 0.6rem; }
  .refs-list :global(a) { color: var(--blue); text-underline-offset: 0.18em; overflow-wrap: anywhere; }
</style>
