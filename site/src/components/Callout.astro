---
interface Props {
  label: string;
  title: string;
  href: string;
}
const { label, title, href } = Astro.props;
---
<aside class="callout">
  <p class="label callout-label">{label}</p>
  <h3 class="callout-title">{title}</h3>
  <div class="callout-journal"><slot /></div>
  <a class="callout-link" href={href}>Read the paper</a>
</aside>

<style>
  .callout {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue);
    border-radius: var(--radius);
    background: var(--paper-2);
    max-width: var(--measure);
  }
  .callout-label { color: var(--blue-deep); }
  .callout-title { font-size: 1.375rem; line-height: 1.25; }
  .callout-journal { color: var(--ink-2); font-size: var(--fs-caption); }
  .callout-link { justify-self: start; color: var(--blue); font-weight: 600; text-underline-offset: 0.18em; }
  .callout-link:hover { color: var(--blue-deep); }
</style>
