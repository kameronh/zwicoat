---
import { imageSize } from '../lib/imagesize';
import { shortSourceFor } from '../data/source-short';

interface Props {
  name: string;
  alt: string;
  caption: string;
  /** The full source: the record, kept in code. Not displayed when a short source exists. */
  source: string;
  /** The displayed source line (citation plus figure numbers). Defaults to the manifest's source_short for this chart. */
  sourceShort?: string;
  width?: number;
  /** Rendered width cap in CSS pixels. Defaults to the chart's design width (see below). */
  maxWidth?: number;
  format?: 'png' | 'svg';
}
const { name, alt, caption, source, sourceShort, width = 1000, maxWidth, format = 'png' } = Astro.props;
const shown = sourceShort ?? shortSourceFor(name) ?? source;
const src = `/figures/${name}.${format}`;
const size = imageSize(src);
const height = Math.round((width * size.height) / size.width);
/*
  Sizing (round five, R19): the PNGs are drawn at 2x, so half the pixel width is the size at which
  the chart text reads at its intended point size. A chart never renders wider than that (no
  oversized text), and pages give wide charts a full-width row so they reach it (rendered width at
  least about 45 percent of the PNG width). Tall charts are capped at 45 percent so they fit a screen.
*/
const designWidth = Math.round(size.width * (size.height / size.width > 0.9 ? 0.45 : 0.5));
const cap = maxWidth ?? designWidth;
// Theme B draws a title block (figure number and source) above the image. Hidden in every other theme.
const figId = name.split('_')[0];
---
<figure class="figure" style={`max-width: min(100%, ${cap}px);`} data-design-width={designWidth}>
  <div class="fig-frame">
    <p class="fig-tag" aria-hidden="true"><span class="fig-tag-id">FIG {figId}</span><span class="fig-tag-src">{shown}</span></p>
    <img class="figure-img" src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption class="figure-cap">
    <p class="figure-caption">{caption}</p>
    <p class="figure-source label">Source: {shown}</p>
  </figcaption>
</figure>

<style>
  .figure { margin: 0; min-width: 0; max-width: 100%; }
  /* The frame is a thin drawing border with a mono title block along the top
     (the default design; themes a and c turn the tag and border off with tokens). */
  .fig-frame { min-width: 0; max-width: 100%; border: var(--fig-frame-border); background: var(--paper); }
  /* The image never exceeds its frame, whatever its width and height attributes say. */
  .figure-img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border: var(--fig-img-border);
    border-radius: var(--radius);
    background: var(--paper);
  }
  .figure-cap { margin-top: var(--space-3); display: grid; gap: 0.35rem; max-width: var(--measure); }
  .figure-caption { color: var(--ink); }
  .figure-source { text-transform: none; letter-spacing: 0.02em; line-height: 1.5; }

</style>
