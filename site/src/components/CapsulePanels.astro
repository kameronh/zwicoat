---
/*
  Horne 2023, Fig 4, as four separate images in a static 2 x 2 grid: silicone row on top,
  platinum row below; uncoated on the left, coated on the right. No buttons, no JavaScript.
  Each cell has a hairline frame and a label chip in its top-left corner.
*/
interface Img { src: string; alt: string; label: string; w: number; h: number }
interface Col { key: string; title: string; uncoated: Img; coated: Img }
const cols: Col[] = [
  {
    key: 'silicone',
    title: 'Silicone',
    uncoated: {
      src: '/images/lab/capsule-pdms-uncoated.jpg',
      alt: 'Tissue section next to uncoated silicone (PDMS) on an implanted array, explanted from a mouse. A thick blue-stained band of fibrous capsule runs along the silicone surface, marked by red lines across its width.',
      label: 'Uncoated silicone',
      w: 1178,
      h: 1034,
    },
    coated: {
      src: '/images/lab/capsule-pdms-coated.jpg',
      alt: 'Tissue section next to coated silicone (PDMS) on an implanted array, explanted from a mouse. The pink hydrogel coating lies on the silicone, and the blue capsule beyond it is a thin line, marked by short red lines.',
      label: 'Coated silicone',
      w: 1163,
      h: 1034,
    },
  },
  {
    key: 'platinum',
    title: 'Platinum',
    uncoated: {
      src: '/images/lab/capsule-pt-uncoated.jpg',
      alt: 'Tissue section next to an uncoated platinum contact on an implanted array, explanted from a mouse. A wide wedge of fibrous capsule, outlined with a red dashed line and labeled Capsule, sits against the black platinum. Scale bar 100 micrometers.',
      label: 'Uncoated platinum',
      w: 1169,
      h: 1058,
    },
    coated: {
      src: '/images/lab/capsule-pt-coated.jpg',
      alt: 'Tissue section next to a coated platinum contact on an implanted array, explanted from a mouse. The pink hydrogel coating lies on the black platinum, and red arrows point to a thin capsule line beyond it, next to normal fat tissue.',
      label: 'Coated platinum',
      w: 1179,
      h: 1058,
    },
  },
];
const caption =
  'Reduced capsule at silicone and platinum interfaces on an implanted array. Explanted sections show a thick fibrotic capsule on uncoated silicone and uncoated platinum, but a thin, quiet interface on coated silicone and coated platinum. Mean capsule thickness on the device fell about 60 percent, 47 to 18 micrometers, with coating.';
const credit = 'Adapted from Horne et al., Acta Biomaterialia 2023';
---
<figure class="cp" data-capsule-panels>
  <div class="cp-box">
    <p class="fig-tag" aria-hidden="true"><span class="fig-tag-id">PHOTO</span><span class="fig-tag-src">{credit}</span></p>
    <div class="cp-grid">
      {cols.flatMap((c) => (['uncoated', 'coated'] as const).map((k) => (
        <div class={`cp-img cp-${c.key}-${k}`}>
          <img src={c[k].src} alt={c[k].alt} width={c[k].w} height={c[k].h} loading="lazy" decoding="async" />
          <p class="cp-label">{c[k].label}</p>
        </div>
      )))}
    </div>
  </div>
  <figcaption class="cp-cap">
    <p class="cp-caption">{caption}</p>
    <p class="cp-credit label">{credit}</p>
  </figcaption>
</figure>

<style>
  .cp { margin: 0; min-width: 0; max-width: 56rem; }
  .cp-box { border: var(--frame-border); background: var(--paper); }
  /* Static 2 x 2: row 1 silicone, row 2 platinum; column 1 uncoated, column 2 coated. Two columns at every width. */
  .cp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 12px; }
  .cp-img { position: relative; margin: 0; min-width: 0; aspect-ratio: 9 / 8; overflow: hidden; border: 1px solid var(--line); }
  .cp-img img { display: block; width: 100%; height: 100%; object-fit: cover; background: var(--paper-2); }
  /* Label chip on the image, top-left: translucent white, body-size bold text. */
  .cp-label {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    margin: 0;
    padding: 0.2rem 0.5rem;
    max-width: calc(100% - 1rem);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 700;
    line-height: 1.3;
    color: #111;
    background: rgb(255 255 255 / 0.82);
    border-radius: var(--radius);
  }
  @media (max-width: 520px) {
    .cp-grid { gap: 8px; padding: 8px; }
    .cp-label { top: 0.3rem; left: 0.3rem; padding: 0.15rem 0.35rem; max-width: calc(100% - 0.6rem); }
  }
  .cp-cap { margin-top: var(--space-3); display: grid; gap: 0.35rem; max-width: var(--measure); }
  .cp-caption { color: var(--ink); }
  .cp-credit { text-transform: none; letter-spacing: 0.02em; line-height: 1.5; }
</style>
