---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  /** Displayed instead of credit when given (the short citation); credit stays as the record. */
  sourceShort?: string;
  /** Rendered width cap in CSS pixels (keeps small originals from being upscaled). */
  maxWidth?: number;
  /** width/height of the frame, written "w/h". Use the image's own ratio. */
  aspect?: string;
  /** Crop to fill the frame. Without it, tall and square images are shown whole (contain). */
  cover?: boolean;
}
const { src, alt, caption, credit: creditFull, sourceShort, maxWidth, aspect = '4/3', cover = false } = Astro.props;
const credit = sourceShort ?? creditFull;
const [aw, ah] = aspect.split('/').map(Number);
const ratio = aw && ah ? aw / ah : 4 / 3;
const fit = cover || ratio > 1.1 ? 'cover' : 'contain';
---
<figure class="photo" style={`--ratio: ${ratio.toFixed(4)};${maxWidth ? ` --max-w: ${maxWidth}px;` : ''}`}>
  <div class="photo-box">
    {credit && <p class="fig-tag" aria-hidden="true"><span class="fig-tag-id">PHOTO</span><span class="fig-tag-src">{credit}</span></p>}
    <div class={`photo-frame fit-${fit}`} style={`aspect-ratio: ${aspect};`}>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  </div>
  {(caption || credit) && (
    <figcaption class="photo-cap">
      {caption && <p class="photo-caption">{caption}</p>}
      {credit && <p class="photo-credit label">{credit}</p>}
    </figcaption>
  )}
</figure>

<style>
  /* A tall or square photo is held to a height of about 78% of the screen, so it never fills the page. */
  .photo { margin: 0; min-width: 0; max-width: min(100%, calc(78vh * var(--ratio)), var(--max-w, 100vw)); }
  .photo-box { min-width: 0; border: var(--frame-border); background: var(--paper); }
  .photo-frame { width: 100%; max-width: 100%; overflow: hidden; background: var(--paper-2); }
  .photo-frame img { width: 100%; max-width: 100%; height: 100%; }
  .fit-cover img { object-fit: cover; }
  .fit-contain img { object-fit: contain; }
  .photo-cap { margin-top: var(--space-3); display: grid; gap: 0.35rem; max-width: var(--measure); }
  .photo-credit { text-transform: none; letter-spacing: 0.02em; line-height: 1.5; }
</style>
