---
interface Props {
  title: string;
  body: string;
  button: { text: string; href: string };
}
const { title, body, button } = Astro.props;
---
<section class="band-wrap" aria-labelledby="cta-title">
  <div class="container">
    <div class="band">
      <div class="band-text">
        <h2 id="cta-title">{title}</h2>
        <p>{body}</p>
      </div>
      <a class="band-btn" href={button.href}>{button.text}</a>
    </div>
  </div>
</section>

<style>
  .band-wrap { padding-block: var(--section-y) 0; }
  .band {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background: var(--blue-deep);
    color: var(--on-blue);
    border-radius: var(--radius);
  }
  .band h2 { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); max-width: 22ch; }
  .band p { margin-top: var(--space-3); font-size: var(--fs-lead); line-height: 1.5; max-width: 52ch; }
  .band-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    min-height: 48px;
    padding: 0.7rem 1.5rem;
    font-weight: 600;
    color: var(--on-blue);
    text-decoration: none;
    border: 2px solid var(--on-blue);
    border-radius: var(--radius);
    transition: background-color 0.15s, color 0.15s;
  }
  .band-btn:hover { background: var(--on-blue); color: var(--blue-deep); }
  .band-btn:focus-visible { outline-color: var(--on-blue); outline-offset: 3px; }
  @media (min-width: 900px) {
    .band { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-6); }
    .band-btn { justify-self: end; }
  }
</style>
