---
/*
  A static row of framed photographs, modeled on CapsulePanels: hairline frame around the set,
  12 px gaps, a hairline around each cell and an optional label chip in its top-left corner.
  Every item sits in one row on desktop; phones get set.phoneCols columns. No JavaScript.
  The sets live in src/lib/photoPanels.ts and are placed with {{panels:name}}.
*/
import { PANEL_SETS } from '../lib/photoPanels';
interface Props { name: string }
const { name } = Astro.props;
const set = PANEL_SETS[name];
if (!set) throw new Error(`PhotoPanels: unknown set ${name}`);
const style = `--pp-cols: ${set.items.length}; --pp-phone-cols: ${set.phoneCols}; --pp-aspect: ${set.aspect};`;
---
<figure class="pp" data-photo-panels={name} style={style}>
  <div class="pp-box">
    <p class="fig-tag" aria-hidden="true"><span class="fig-tag-id">PHOTO</span><span class="fig-tag-src">{set.credit}</span></p>
    <div class="pp-grid">
      {set.items.map((it) => (
        <div class="pp-img">
          <img src={it.src} alt={it.alt} width={it.w} height={it.h} loading="lazy" decoding="async" />
          {it.label && <p class="pp-label">{it.label}</p>}
        </div>
      ))}
    </div>
  </div>
  <figcaption class="pp-cap">
    <p class="pp-caption">{set.caption}</p>
    <p class="pp-credit label">{set.credit}</p>
  </figcaption>
</figure>

<style>
  .pp { margin: 0; min-width: 0; }
  .pp-box { border: var(--frame-border); background: var(--paper); }
  .pp-grid { display: grid; grid-template-columns: repeat(var(--pp-cols), minmax(0, 1fr)); gap: 12px; padding: 12px; }
  .pp-img { position: relative; margin: 0; min-width: 0; aspect-ratio: var(--pp-aspect); overflow: hidden; border: 1px solid var(--line); }
  .pp-img img { display: block; width: 100%; height: 100%; object-fit: cover; background: var(--paper-2); }
  /* Label chip on the image, top-left: translucent white, bold text, as in CapsulePanels. */
  .pp-label {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    margin: 0;
    padding: 0.2rem 0.5rem;
    max-width: calc(100% - 1rem);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 700;
    line-height: 1.3;
    color: #111;
    background: rgb(255 255 255 / 0.82);
    border-radius: var(--radius);
  }
  @media (max-width: 640px) {
    .pp-grid { grid-template-columns: repeat(var(--pp-phone-cols), minmax(0, 1fr)); gap: 8px; padding: 8px; }
    .pp-label { top: 0.3rem; left: 0.3rem; padding: 0.15rem 0.35rem; max-width: calc(100% - 0.6rem); }
  }
  .pp-cap { margin-top: var(--space-3); display: grid; gap: 0.35rem; max-width: var(--measure); }
  .pp-caption { color: var(--ink); }
  .pp-credit { text-transform: none; letter-spacing: 0.02em; line-height: 1.5; }
</style>
